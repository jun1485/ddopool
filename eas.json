{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": { "buildType": "apk" }
    },
    "preview-aab": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": { "buildType": "app-bundle" }
    },
    "production": {
      "environment": "production",
      "env": { "APP_ENV": "production", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "closed-testing": {
      "android": {
        "serviceAccountKeyPath": "../.secrets/ddopool-play-service-account.json",
        "track": "alpha",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "../.secrets/ddopool-play-service-account.json",
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
