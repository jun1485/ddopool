# Supabase 연동 (미설정 시 로컬 mock 모드로 동작)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry 오류 수집 (미설정 시 수집 비활성)
EXPO_PUBLIC_SENTRY_DSN=

# 웹 배포 도메인 (예: https://ddopool.app)
# 공유 카드 og:image 절대 URL 생성에 사용. 미설정 시 상대 경로로 떨어져
# 카카오톡·페이스북 공유 시 썸네일이 표시되지 않는다.
EXPO_PUBLIC_SITE_URL=

# 공개 법률 문서 정보
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_PRIVACY_OFFICER_NAME=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE=

# EAS 프로젝트 연결
EAS_PROJECT_ID=

# 웹 푸시 공개 키 · 서버 WEB_PUSH_PUBLIC_KEY와 동일한 값
EXPO_PUBLIC_WEB_PUSH_KEY=
# 운영 작업 서버에서만 설정 · 비밀 키는 EXPO_PUBLIC 접두어 사용 금지
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
